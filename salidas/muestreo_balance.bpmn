<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_muestreo_balance" targetNamespace="urn:procesos-bpmn:muestreo_balance" exporter="procesos-bpmn" exporterVersion="0.1.0">
  <collaboration id="Colab_muestreo_balance">
    <participant id="Piscina_muestreo_balance" name="Muestreo de planta y balance metalúrgico" processRef="Proceso_muestreo_balance"/>
  </collaboration>
  <process id="Proceso_muestreo_balance" name="Muestreo de planta y balance metalúrgico" isExecutable="false">
    <documentation>Procedimiento genérico e ilustrativo de una campaña de muestreo para cerrar el balance de un circuito de molienda y clasificación. La reconciliación por mínimos cuadrados es la que implementa el proyecto simulador-conminucion.</documentation>
    <laneSet id="Carriles_muestreo_balance">
      <lane id="Carril_1" name="Metalurgista">
        <flowNodeRef>inicio</flowNodeRef>
        <flowNodeRef>plan</flowNodeRef>
        <flowNodeRef>coordinar</flowNodeRef>
        <flowNodeRef>reconciliar</flowNodeRef>
        <flowNodeRef>g_ajustes</flowNodeRef>
        <flowNodeRef>revisar</flowNodeRef>
        <flowNodeRef>calcular</flowNodeRef>
        <flowNodeRef>informe</flowNodeRef>
        <flowNodeRef>fin</flowNodeRef>
      </lane>
      <lane id="Carril_2" name="Operador de planta">
        <flowNodeRef>g_estable</flowNodeRef>
        <flowNodeRef>esperar</flowNodeRef>
        <flowNodeRef>tomar</flowNodeRef>
        <flowNodeRef>rotular</flowNodeRef>
      </lane>
      <lane id="Carril_3" name="Laboratorio">
        <flowNodeRef>preparar</flowNodeRef>
        <flowNodeRef>p_div</flowNodeRef>
        <flowNodeRef>granulometria</flowNodeRef>
        <flowNodeRef>quimica</flowNodeRef>
        <flowNodeRef>p_union</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="inicio" name="Campaña de muestreo programada">
      <outgoing>Flujo_1</outgoing>
    </startEvent>
    <userTask id="plan" name="Definir puntos, incrementos y masa mínima">
      <incoming>Flujo_1</incoming>
      <outgoing>Flujo_2</outgoing>
    </userTask>
    <userTask id="coordinar" name="Coordinar con operación y laboratorio">
      <incoming>Flujo_2</incoming>
      <outgoing>Flujo_3</outgoing>
    </userTask>
    <exclusiveGateway id="g_estable" name="¿Planta estable al menos 1 h?">
      <incoming>Flujo_3</incoming>
      <incoming>Flujo_5</incoming>
      <outgoing>Flujo_4</outgoing>
      <outgoing>Flujo_6</outgoing>
    </exclusiveGateway>
    <intermediateCatchEvent id="esperar" name="Esperar estabilidad">
      <incoming>Flujo_4</incoming>
      <outgoing>Flujo_5</outgoing>
      <timerEventDefinition id="Temporizador_esperar"/>
    </intermediateCatchEvent>
    <manualTask id="tomar" name="Tomar incrementos cada 15 min">
      <incoming>Flujo_6</incoming>
      <incoming>Flujo_17</incoming>
      <outgoing>Flujo_7</outgoing>
    </manualTask>
    <manualTask id="rotular" name="Componer, rotular y enviar muestras">
      <incoming>Flujo_7</incoming>
      <outgoing>Flujo_8</outgoing>
    </manualTask>
    <task id="preparar" name="Secar, dividir y preparar">
      <incoming>Flujo_8</incoming>
      <outgoing>Flujo_9</outgoing>
    </task>
    <parallelGateway id="p_div" name="Ensayos en paralelo">
      <incoming>Flujo_9</incoming>
      <outgoing>Flujo_10</outgoing>
      <outgoing>Flujo_11</outgoing>
    </parallelGateway>
    <task id="granulometria" name="Granulometría">
      <incoming>Flujo_10</incoming>
      <outgoing>Flujo_12</outgoing>
    </task>
    <task id="quimica" name="Análisis químico">
      <incoming>Flujo_11</incoming>
      <outgoing>Flujo_13</outgoing>
    </task>
    <parallelGateway id="p_union" name="Resultados completos">
      <incoming>Flujo_12</incoming>
      <incoming>Flujo_13</incoming>
      <outgoing>Flujo_14</outgoing>
    </parallelGateway>
    <serviceTask id="reconciliar" name="Reconciliar el balance por mínimos cuadrados">
      <incoming>Flujo_14</incoming>
      <outgoing>Flujo_15</outgoing>
    </serviceTask>
    <exclusiveGateway id="g_ajustes" name="¿Ajustes dentro del error de muestreo?">
      <incoming>Flujo_15</incoming>
      <outgoing>Flujo_16</outgoing>
      <outgoing>Flujo_18</outgoing>
    </exclusiveGateway>
    <userTask id="revisar" name="Revisar datos atípicos y repetir puntos">
      <incoming>Flujo_16</incoming>
      <outgoing>Flujo_17</outgoing>
    </userTask>
    <serviceTask id="calcular" name="Calcular recuperación y carga circulante">
      <incoming>Flujo_18</incoming>
      <outgoing>Flujo_19</outgoing>
    </serviceTask>
    <userTask id="informe" name="Emitir informe metalúrgico">
      <incoming>Flujo_19</incoming>
      <outgoing>Flujo_20</outgoing>
    </userTask>
    <endEvent id="fin" name="Balance cerrado">
      <incoming>Flujo_20</incoming>
    </endEvent>
    <sequenceFlow id="Flujo_1" sourceRef="inicio" targetRef="plan"/>
    <sequenceFlow id="Flujo_2" sourceRef="plan" targetRef="coordinar"/>
    <sequenceFlow id="Flujo_3" sourceRef="coordinar" targetRef="g_estable"/>
    <sequenceFlow id="Flujo_4" sourceRef="g_estable" targetRef="esperar" name="No"/>
    <sequenceFlow id="Flujo_5" sourceRef="esperar" targetRef="g_estable"/>
    <sequenceFlow id="Flujo_6" sourceRef="g_estable" targetRef="tomar" name="Sí"/>
    <sequenceFlow id="Flujo_7" sourceRef="tomar" targetRef="rotular"/>
    <sequenceFlow id="Flujo_8" sourceRef="rotular" targetRef="preparar"/>
    <sequenceFlow id="Flujo_9" sourceRef="preparar" targetRef="p_div"/>
    <sequenceFlow id="Flujo_10" sourceRef="p_div" targetRef="granulometria"/>
    <sequenceFlow id="Flujo_11" sourceRef="p_div" targetRef="quimica"/>
    <sequenceFlow id="Flujo_12" sourceRef="granulometria" targetRef="p_union"/>
    <sequenceFlow id="Flujo_13" sourceRef="quimica" targetRef="p_union"/>
    <sequenceFlow id="Flujo_14" sourceRef="p_union" targetRef="reconciliar"/>
    <sequenceFlow id="Flujo_15" sourceRef="reconciliar" targetRef="g_ajustes"/>
    <sequenceFlow id="Flujo_16" sourceRef="g_ajustes" targetRef="revisar" name="No"/>
    <sequenceFlow id="Flujo_17" sourceRef="revisar" targetRef="tomar"/>
    <sequenceFlow id="Flujo_18" sourceRef="g_ajustes" targetRef="calcular" name="Sí"/>
    <sequenceFlow id="Flujo_19" sourceRef="calcular" targetRef="informe"/>
    <sequenceFlow id="Flujo_20" sourceRef="informe" targetRef="fin"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagrama_muestreo_balance">
    <bpmndi:BPMNPlane id="Plano_muestreo_balance" bpmnElement="Colab_muestreo_balance">
      <bpmndi:BPMNShape id="Piscina_muestreo_balance_di" bpmnElement="Piscina_muestreo_balance" isHorizontal="true">
        <dc:Bounds x="30" y="30" width="2540" height="720"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_1_di" bpmnElement="Carril_1" isHorizontal="true">
        <dc:Bounds x="60" y="30" width="2510" height="240"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_2_di" bpmnElement="Carril_2" isHorizontal="true">
        <dc:Bounds x="60" y="270" width="2510" height="240"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_3_di" bpmnElement="Carril_3" isHorizontal="true">
        <dc:Bounds x="60" y="510" width="2510" height="240"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="inicio_di" bpmnElement="inicio">
        <dc:Bounds x="167" y="72" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="plan_di" bpmnElement="plan">
        <dc:Bounds x="290" y="60" width="110" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="coordinar_di" bpmnElement="coordinar">
        <dc:Bounds x="450" y="60" width="110" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_estable_di" bpmnElement="g_estable" isMarkerVisible="true">
        <dc:Bounds x="640" y="305" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="esperar_di" bpmnElement="esperar">
        <dc:Bounds x="807" y="312" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="tomar_di" bpmnElement="tomar">
        <dc:Bounds x="770" y="420" width="110" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rotular_di" bpmnElement="rotular">
        <dc:Bounds x="930" y="300" width="110" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="preparar_di" bpmnElement="preparar">
        <dc:Bounds x="1090" y="540" width="110" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p_div_di" bpmnElement="p_div">
        <dc:Bounds x="1280" y="545" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="granulometria_di" bpmnElement="granulometria">
        <dc:Bounds x="1410" y="540" width="110" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="quimica_di" bpmnElement="quimica">
        <dc:Bounds x="1410" y="660" width="110" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="p_union_di" bpmnElement="p_union">
        <dc:Bounds x="1600" y="545" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="reconciliar_di" bpmnElement="reconciliar">
        <dc:Bounds x="1730" y="60" width="110" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_ajustes_di" bpmnElement="g_ajustes" isMarkerVisible="true">
        <dc:Bounds x="1920" y="65" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="revisar_di" bpmnElement="revisar">
        <dc:Bounds x="2050" y="60" width="110" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="calcular_di" bpmnElement="calcular">
        <dc:Bounds x="2050" y="180" width="110" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="informe_di" bpmnElement="informe">
        <dc:Bounds x="2210" y="60" width="110" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin_di" bpmnElement="fin">
        <dc:Bounds x="2407" y="72" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flujo_1_di" bpmnElement="Flujo_1">
        <di:waypoint x="203" y="90"/>
        <di:waypoint x="290" y="90"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_2_di" bpmnElement="Flujo_2">
        <di:waypoint x="400" y="90"/>
        <di:waypoint x="450" y="90"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_3_di" bpmnElement="Flujo_3">
        <di:waypoint x="560" y="90"/>
        <di:waypoint x="620" y="90"/>
        <di:waypoint x="620" y="330"/>
        <di:waypoint x="640" y="330"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_4_di" bpmnElement="Flujo_4">
        <di:waypoint x="690" y="330"/>
        <di:waypoint x="807" y="330"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_5_di" bpmnElement="Flujo_5">
        <di:waypoint x="843" y="330"/>
        <di:waypoint x="900" y="330"/>
        <di:waypoint x="900" y="289"/>
        <di:waypoint x="580" y="289"/>
        <di:waypoint x="580" y="330"/>
        <di:waypoint x="640" y="330"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_6_di" bpmnElement="Flujo_6">
        <di:waypoint x="665" y="355"/>
        <di:waypoint x="665" y="450"/>
        <di:waypoint x="770" y="450"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_7_di" bpmnElement="Flujo_7">
        <di:waypoint x="880" y="450"/>
        <di:waypoint x="910" y="450"/>
        <di:waypoint x="910" y="330"/>
        <di:waypoint x="930" y="330"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_8_di" bpmnElement="Flujo_8">
        <di:waypoint x="1040" y="330"/>
        <di:waypoint x="1070" y="330"/>
        <di:waypoint x="1070" y="570"/>
        <di:waypoint x="1090" y="570"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_9_di" bpmnElement="Flujo_9">
        <di:waypoint x="1200" y="570"/>
        <di:waypoint x="1280" y="570"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_10_di" bpmnElement="Flujo_10">
        <di:waypoint x="1330" y="570"/>
        <di:waypoint x="1410" y="570"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_11_di" bpmnElement="Flujo_11">
        <di:waypoint x="1305" y="595"/>
        <di:waypoint x="1305" y="690"/>
        <di:waypoint x="1410" y="690"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_12_di" bpmnElement="Flujo_12">
        <di:waypoint x="1520" y="570"/>
        <di:waypoint x="1600" y="570"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_13_di" bpmnElement="Flujo_13">
        <di:waypoint x="1520" y="690"/>
        <di:waypoint x="1580" y="690"/>
        <di:waypoint x="1580" y="570"/>
        <di:waypoint x="1600" y="570"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_14_di" bpmnElement="Flujo_14">
        <di:waypoint x="1625" y="545"/>
        <di:waypoint x="1625" y="90"/>
        <di:waypoint x="1730" y="90"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_15_di" bpmnElement="Flujo_15">
        <di:waypoint x="1840" y="90"/>
        <di:waypoint x="1920" y="90"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_16_di" bpmnElement="Flujo_16">
        <di:waypoint x="1970" y="90"/>
        <di:waypoint x="2050" y="90"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flujo_17_di" bpmnElement="Flujo_17">
        <di:waypoint x="2160" y="90"/>
        <di:waypoint x="2180" y="90"/>
        <di:waypoint x="2180" y="44"/>
        <di:waypoint x="740" y="44"/>
        <di:waypoint x="740" y="450"/>
        <di:waypoint x="770" y="450"/>
      </bpmndi:BPMNEdge>
