      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="analisis_di" bpmnElement="analisis">
        <dc:Bounds x="770" y="660" width="110" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_refino_di" bpmnElement="g_refino" isMarkerVisible="true">
        <dc:Bounds x="960" y="305" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ajuste_sx_di" bpmnElement="ajuste_sx">
        <dc:Bounds x="1090" y="300" width="110" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="espera_sx_di" bpmnElement="espera_sx">
