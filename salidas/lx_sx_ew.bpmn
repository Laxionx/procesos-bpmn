      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="calidad_di" bpmnElement="calidad">
        <dc:Bounds x="1410" y="660" width="110" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_calidad_di" bpmnElement="g_calidad" isMarkerVisible="true">
        <dc:Bounds x="1600" y="665" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="segregar_di" bpmnElement="segregar">
        <dc:Bounds x="1730" y="60" width="110" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="despacho_di" bpmnElement="despacho">
        <dc:Bounds x="1730" y="420" width="110" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="registro_di" bpmnElement="registro">
        <dc:Bounds x="1890" y="60" width="110" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin_di" bpmnElement="fin">
        <dc:Bounds x="2087" y="72" width="36" height="36"/>
      </bpmndi:BPMNShape>
