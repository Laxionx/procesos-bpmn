<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_lx_sx_ew" targetNamespace="urn:procesos-bpmn:lx_sx_ew" exporter="procesos-bpmn" exporterVersion="0.1.0">
  <collaboration id="Colab_lx_sx_ew">
    <participant id="Piscina_lx_sx_ew" name="Control operacional de turno en una planta LX-SX-EW" processRef="Proceso_lx_sx_ew"/>
  </collaboration>
  <process id="Proceso_lx_sx_ew" name="Control operacional de turno en una planta LX-SX-EW" isExecutable="false">
    <documentation>Procedimiento genérico e ilustrativo del control de un turno en una planta de lixiviación, extracción por solventes y electroobtención de cobre. No es el procedimiento de una empresa: los rangos de control los fija cada planta.</documentation>
    <laneSet id="Carriles_lx_sx_ew">
      <lane id="Carril_1" name="Supervisor de turno">
        <flowNodeRef>inicio</flowNodeRef>
        <flowNodeRef>entrega</flowNodeRef>
        <flowNodeRef>segregar</flowNodeRef>
        <flowNodeRef>registro</flowNodeRef>
        <flowNodeRef>fin</flowNodeRef>
      </lane>
      <lane id="Carril_2" name="Operador de lixiviación">
        <flowNodeRef>riego</flowNodeRef>
        <flowNodeRef>muestras</flowNodeRef>
      </lane>
      <lane id="Carril_3" name="Operador de SX">
        <flowNodeRef>g_refino</flowNodeRef>
        <flowNodeRef>ajuste_sx</flowNodeRef>
        <flowNodeRef>espera_sx</flowNodeRef>
      </lane>
      <lane id="Carril_4" name="Operador de EW">
        <flowNodeRef>g_electrolito</flowNodeRef>
        <flowNodeRef>ajuste_ew</flowNodeRef>
        <flowNodeRef>cosecha</flowNodeRef>
        <flowNodeRef>despacho</flowNodeRef>
      </lane>
      <lane id="Carril_5" name="Laboratorio químico">
        <flowNodeRef>analisis</flowNodeRef>
        <flowNodeRef>calidad</flowNodeRef>
        <flowNodeRef>g_calidad</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="inicio" name="Inicio de turno">
      <outgoing>Flujo_1</outgoing>
    </startEvent>
    <userTask id="entrega" name="Recibir entrega de turno y novedades">
      <incoming>Flujo_1</incoming>
      <outgoing>Flujo_2</outgoing>
    </userTask>
    <manualTask id="riego" name="Verificar riego de pilas y caudal de PLS">
      <incoming>Flujo_2</incoming>
      <outgoing>Flujo_3</outgoing>
    </manualTask>
    <manualTask id="muestras" name="Tomar muestras de PLS, refino y electrolito">
      <incoming>Flujo_3</incoming>
      <incoming>Flujo_8</incoming>
      <incoming>Flujo_11</incoming>
      <outgoing>Flujo_4</outgoing>
    </manualTask>
    <task id="analisis" name="Analizar Cu, acidez libre, Fe y Mn">
      <incoming>Flujo_4</incoming>
      <outgoing>Flujo_5</outgoing>
    </task>
    <exclusiveGateway id="g_refino" name="¿Cu en refino dentro de rango?">
      <incoming>Flujo_5</incoming>
      <outgoing>Flujo_6</outgoing>
      <outgoing>Flujo_9</outgoing>
    </exclusiveGateway>
    <manualTask id="ajuste_sx" name="Ajustar razón O/A y caudal de orgánico">
      <incoming>Flujo_6</incoming>
      <outgoing>Flujo_7</outgoing>
    </manualTask>
    <intermediateCatchEvent id="espera_sx" name="Esperar estabilización">
      <incoming>Flujo_7</incoming>
      <outgoing>Flujo_8</outgoing>
      <timerEventDefinition id="Temporizador_espera_sx"/>
    </intermediateCatchEvent>
    <exclusiveGateway id="g_electrolito" name="¿Electrolito dentro de rango?">
      <incoming>Flujo_9</incoming>
      <outgoing>Flujo_10</outgoing>
      <outgoing>Flujo_12</outgoing>
    </exclusiveGateway>
    <manualTask id="ajuste_ew" name="Ajustar descarte y aditivos">
      <incoming>Flujo_10</incoming>
      <outgoing>Flujo_11</outgoing>
    </manualTask>
    <manualTask id="cosecha" name="Cosechar cátodos según ciclo">
      <incoming>Flujo_12</incoming>
      <outgoing>Flujo_13</outgoing>
    </manualTask>
    <task id="calidad" name="Inspeccionar y muestrear cátodos">
      <incoming>Flujo_13</incoming>
      <outgoing>Flujo_14</outgoing>
    </task>
    <exclusiveGateway id="g_calidad" name="¿Cátodo cumple grado A?">
      <incoming>Flujo_14</incoming>
      <outgoing>Flujo_15</outgoing>
      <outgoing>Flujo_16</outgoing>
    </exclusiveGateway>
    <userTask id="segregar" name="Segregar lote e informar desvío">
      <incoming>Flujo_16</incoming>
      <outgoing>Flujo_18</outgoing>
    </userTask>
    <manualTask id="despacho" name="Pesar, flejar y enviar a bodega">
      <incoming>Flujo_15</incoming>
      <outgoing>Flujo_17</outgoing>
    </manualTask>
    <userTask id="registro" name="Registrar indicadores del turno">
      <incoming>Flujo_17</incoming>
      <incoming>Flujo_18</incoming>
      <outgoing>Flujo_19</outgoing>
    </userTask>
    <endEvent id="fin" name="Turno cerrado">
      <incoming>Flujo_19</incoming>
    </endEvent>
    <sequenceFlow id="Flujo_1" sourceRef="inicio" targetRef="entrega"/>
    <sequenceFlow id="Flujo_2" sourceRef="entrega" targetRef="riego"/>
    <sequenceFlow id="Flujo_3" sourceRef="riego" targetRef="muestras"/>
    <sequenceFlow id="Flujo_4" sourceRef="muestras" targetRef="analisis"/>
    <sequenceFlow id="Flujo_5" sourceRef="analisis" targetRef="g_refino"/>
    <sequenceFlow id="Flujo_6" sourceRef="g_refino" targetRef="ajuste_sx" name="No"/>
    <sequenceFlow id="Flujo_7" sourceRef="ajuste_sx" targetRef="espera_sx"/>
    <sequenceFlow id="Flujo_8" sourceRef="espera_sx" targetRef="muestras"/>
    <sequenceFlow id="Flujo_9" sourceRef="g_refino" targetRef="g_electrolito" name="Sí"/>
    <sequenceFlow id="Flujo_10" sourceRef="g_electrolito" targetRef="ajuste_ew" name="No"/>
    <sequenceFlow id="Flujo_11" sourceRef="ajuste_ew" targetRef="muestras"/>
    <sequenceFlow id="Flujo_12" sourceRef="g_electrolito" targetRef="cosecha" name="Sí"/>
    <sequenceFlow id="Flujo_13" sourceRef="cosecha" targetRef="calidad"/>
    <sequenceFlow id="Flujo_14" sourceRef="calidad" targetRef="g_calidad"/>
    <sequenceFlow id="Flujo_15" sourceRef="g_calidad" targetRef="despacho" name="Sí"/>
    <sequenceFlow id="Flujo_16" sourceRef="g_calidad" targetRef="segregar" name="No"/>
    <sequenceFlow id="Flujo_17" sourceRef="despacho" targetRef="registro"/>
    <sequenceFlow id="Flujo_18" sourceRef="segregar" targetRef="registro"/>
    <sequenceFlow id="Flujo_19" sourceRef="registro" targetRef="fin"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagrama_lx_sx_ew">
    <bpmndi:BPMNPlane id="Plano_lx_sx_ew" bpmnElement="Colab_lx_sx_ew">
      <bpmndi:BPMNShape id="Piscina_lx_sx_ew_di" bpmnElement="Piscina_lx_sx_ew" isHorizontal="true">
        <dc:Bounds x="30" y="30" width="2220" height="720"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Carril_1_di" bpmnElement="Carril_1" isHorizontal="true">
        <dc:Bounds x="60" y="30" width="2190" height="120"/>
      </bpmndi:BPMNShape>
