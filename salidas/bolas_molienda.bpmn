<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definiciones_bolas_molienda" targetNamespace="urn:procesos-bpmn:bolas_molienda" exporter="procesos-bpmn" exporterVersion="0.1.0">
  <collaboration id="Colab_bolas_molienda">
    <participant id="Piscina_bolas_molienda" name="Fabricación de bolas de molienda de alto cromo en coquilla" processRef="Proceso_bolas_molienda"/>
  </collaboration>
  <process id="Proceso_bolas_molienda" name="Fabricación de bolas de molienda de alto cromo en coquilla" isExecutable="false">
    <documentation>Procedimiento genérico e ilustrativo de la fabricación de bolas de molienda de fundición blanca de alto cromo coladas en coquilla. La secuencia de pasos se revisó con la experiencia práctica del autor en fundición. No reproduce el procedimiento de ninguna empresa ni incluye parámetros: la química, las temperaturas, las durezas y el ensayo de caída los fija cada fabricante y cliente. Las coquillas se preparan mientras se funde el metal; el control final del lote lo hace el área de calidad.</documentation>
    <laneSet id="Carriles_bolas_molienda">
      <lane id="Carril_1" name="Fusión">
        <flowNodeRef>inicio</flowNodeRef>
        <flowNodeRef>p_div</flowNodeRef>
        <flowNodeRef>carga</flowNodeRef>
        <flowNodeRef>fundir</flowNodeRef>
        <flowNodeRef>corregir</flowNodeRef>
        <flowNodeRef>rechazo</flowNodeRef>
        <flowNodeRef>fin_rechazo</flowNodeRef>
      </lane>
      <lane id="Carril_2" name="Moldeo en coquilla">
        <flowNodeRef>limpiar</flowNodeRef>
        <flowNodeRef>precalentar</flowNodeRef>
        <flowNodeRef>p_union</flowNodeRef>
        <flowNodeRef>colar</flowNodeRef>
        <flowNodeRef>extraer</flowNodeRef>
        <flowNodeRef>separar</flowNodeRef>
        <flowNodeRef>clasificar</flowNodeRef>
      </lane>
      <lane id="Carril_3" name="Tratamiento térmico">
        <flowNodeRef>templar</flowNodeRef>
        <flowNodeRef>revenir</flowNodeRef>
        <flowNodeRef>g_retratar</flowNodeRef>
      </lane>
      <lane id="Carril_4" name="Control de calidad">
        <flowNodeRef>espectro</flowNodeRef>
        <flowNodeRef>g_quimica</flowNodeRef>
        <flowNodeRef>dureza</flowNodeRef>
        <flowNodeRef>g_dureza</flowNodeRef>
        <flowNodeRef>caida</flowNodeRef>
      </lane>
      <lane id="Carril_5" name="Despacho">
        <flowNodeRef>despacho</flowNodeRef>
        <flowNodeRef>fin</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="inicio" name="Orden de producción">
      <outgoing>Flujo_1</outgoing>
    </startEvent>
    <parallelGateway id="p_div" name="Fusión y coquillas en paralelo">
      <incoming>Flujo_1</incoming>
      <outgoing>Flujo_2</outgoing>
      <outgoing>Flujo_3</outgoing>
    </parallelGateway>
    <manualTask id="carga" name="Preparar carga: chatarra y ferroaleaciones">
      <incoming>Flujo_2</incoming>
      <outgoing>Flujo_4</outgoing>
    </manualTask>
    <manualTask id="fundir" name="Fundir en horno de inducción">
      <incoming>Flujo_4</incoming>
      <outgoing>Flujo_5</outgoing>
    </manualTask>
    <task id="espectro" name="Análisis por espectrometría de emisión">
      <incoming>Flujo_5</incoming>
      <incoming>Flujo_8</incoming>
      <outgoing>Flujo_6</outgoing>
    </task>
    <exclusiveGateway id="g_quimica" name="¿Química en especificación?">
      <incoming>Flujo_6</incoming>
      <outgoing>Flujo_7</outgoing>
      <outgoing>Flujo_9</outgoing>
    </exclusiveGateway>
    <manualTask id="corregir" name="Corregir con ferroaleaciones">
      <incoming>Flujo_7</incoming>
      <outgoing>Flujo_8</outgoing>
    </manualTask>
    <manualTask id="limpiar" name="Limpiar coquillas">
      <incoming>Flujo_3</incoming>
      <outgoing>Flujo_10</outgoing>
    </manualTask>
    <manualTask id="precalentar" name="Precalentar coquillas">
      <incoming>Flujo_10</incoming>
      <outgoing>Flujo_11</outgoing>
    </manualTask>
    <parallelGateway id="p_union" name="Metal y coquillas listos">
      <incoming>Flujo_9</incoming>
      <incoming>Flujo_11</incoming>
      <outgoing>Flujo_12</outgoing>
    </parallelGateway>
    <manualTask id="colar" name="Colar en coquillas">
      <incoming>Flujo_12</incoming>
      <outgoing>Flujo_13</outgoing>
    </manualTask>
    <manualTask id="extraer" name="Abrir coquillas y extraer">
      <incoming>Flujo_13</incoming>
      <outgoing>Flujo_14</outgoing>
    </manualTask>
    <manualTask id="separar" name="Separar bolas y rebarbar">
      <incoming>Flujo_14</incoming>
      <outgoing>Flujo_15</outgoing>
    </manualTask>
    <manualTask id="clasificar" name="Clasificar por diámetro">
      <incoming>Flujo_15</incoming>
      <outgoing>Flujo_16</outgoing>
    </manualTask>
    <manualTask id="templar" name="Templar">
      <incoming>Flujo_16</incoming>
      <incoming>Flujo_22</incoming>
      <outgoing>Flujo_17</outgoing>
    </manualTask>
    <manualTask id="revenir" name="Revenir">
      <incoming>Flujo_17</incoming>
      <outgoing>Flujo_18</outgoing>
    </manualTask>
    <task id="dureza" name="Medir dureza en superficie y núcleo">
      <incoming>Flujo_18</incoming>
      <outgoing>Flujo_19</outgoing>
    </task>
    <exclusiveGateway id="g_dureza" name="¿Dureza en especificación?">
      <incoming>Flujo_19</incoming>
      <outgoing>Flujo_20</outgoing>
      <outgoing>Flujo_21</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="g_retratar" name="¿Se puede volver a tratar?">
      <incoming>Flujo_21</incoming>
      <outgoing>Flujo_22</outgoing>
      <outgoing>Flujo_23</outgoing>
    </exclusiveGateway>
    <manualTask id="rechazo" name="Devolver como chatarra de retorno">
      <incoming>Flujo_23</incoming>
      <outgoing>Flujo_24</outgoing>
    </manualTask>
    <endEvent id="fin_rechazo" name="Lote rechazado">
      <incoming>Flujo_24</incoming>
    </endEvent>
    <task id="caida" name="Ensayo de caída por lote">
      <incoming>Flujo_20</incoming>
      <outgoing>Flujo_25</outgoing>
    </task>
    <manualTask id="despacho" name="Embalar y despachar">
      <incoming>Flujo_25</incoming>
      <outgoing>Flujo_26</outgoing>
    </manualTask>
    <endEvent id="fin" name="Lote despachado">
      <incoming>Flujo_26</incoming>
    </endEvent>
    <sequenceFlow id="Flujo_1" sourceRef="inicio" targetRef="p_div"/>
    <sequenceFlow id="Flujo_2" sourceRef="p_div" targetRef="carga"/>
    <sequenceFlow id="Flujo_3" sourceRef="p_div" targetRef="limpiar"/>
    <sequenceFlow id="Flujo_4" sourceRef="carga" targetRef="fundir"/>
    <sequenceFlow id="Flujo_5" sourceRef="fundir" targetRef="espectro"/>
    <sequenceFlow id="Flujo_6" sourceRef="espectro" targetRef="g_quimica"/>
    <sequenceFlow id="Flujo_7" sourceRef="g_quimica" targetRef="corregir" name="No"/>
    <sequenceFlow id="Flujo_8" sourceRef="corregir" targetRef="espectro"/>
    <sequenceFlow id="Flujo_9" sourceRef="g_quimica" targetRef="p_union" name="Sí"/>
    <sequenceFlow id="Flujo_10" sourceRef="limpiar" targetRef="precalentar"/>
    <sequenceFlow id="Flujo_11" sourceRef="precalentar" targetRef="p_union"/>
    <sequenceFlow id="Flujo_12" sourceRef="p_union" targetRef="colar"/>
    <sequenceFlow id="Flujo_13" sourceRef="colar" targetRef="extraer"/>
    <sequenceFlow id="Flujo_14" sourceRef="extraer" targetRef="separar"/>
    <sequenceFlow id="Flujo_15" sourceRef="separar" targetRef="clasificar"/>
    <sequenceFlow id="Flujo_16" sourceRef="clasificar" targetRef="templar"/>
    <sequenceFlow id="Flujo_17" sourceRef="templar" targetRef="revenir"/>
    <sequenceFlow id="Flujo_18" sourceRef="revenir" targetRef="dureza"/>
    <sequenceFlow id="Flujo_19" sourceRef="dureza" targetRef="g_dureza"/>
    <sequenceFlow id="Flujo_20" sourceRef="g_dureza" targetRef="caida" name="Sí"/>
    <sequenceFlow id="Flujo_21" sourceRef="g_dureza" targetRef="g_retratar" name="No"/>
    <sequenceFlow id="Flujo_22" sourceRef="g_retratar" targetRef="templar" name="Sí"/>
    <sequenceFlow id="Flujo_23" sourceRef="g_retratar" targetRef="rechazo" name="No"/>
    <sequenceFlow id="Flujo_24" sourceRef="rechazo" targetRef="fin_rechazo"/>
    <sequenceFlow id="Flujo_25" sourceRef="caida" targetRef="despacho"/>
    <sequenceFlow id="Flujo_26" sourceRef="despacho" targetRef="fin"/>
  </process>
