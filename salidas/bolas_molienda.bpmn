      <bpmndi:BPMNShape id="g_dureza_di" bpmnElement="g_dureza" isMarkerVisible="true">
        <dc:Bounds x="1600" y="425" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_retratar_di" bpmnElement="g_retratar" isMarkerVisible="true">
