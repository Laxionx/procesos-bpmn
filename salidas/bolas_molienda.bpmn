      <bpmndi:BPMNShape id="rechazo_di" bpmnElement="rechazo">
        <dc:Bounds x="1890" y="60" width="110" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="fin_rechazo_di" bpmnElement="fin_rechazo">
        <dc:Bounds x="2087" y="72" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="caida_di" bpmnElement="caida">
        <dc:Bounds x="1730" y="420" width="110" height="60"/>
